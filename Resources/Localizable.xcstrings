            "state": "translated",
            "value": "Shiduo Pro features"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇 Pro 功能"
          }
        }
      }
    },
    "拾掇 Pro 可以按照片画面搜索，比如「猫」「海边」「收据」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiduo Pro can search photos by what’s in them, like “cat”, “beach” or “receipt”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇 Pro 可以按照片画面搜索，比如「猫」「海边」「收据」"
          }
        }
      }
    },
    "拾掇 Pro 已激活": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiduo Pro is active"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇 Pro 已激活"
          }
        }
      }
    },
    "拾掇 Pro 试用明天到期": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Shiduo Pro trial ends tomorrow"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇 Pro 试用明天到期"
          }
        }
      }
    },
    "拾掇 Shiduo：免费开源的 Mac 文件管家，看图找文件、搜图里的字、清理重复和大文件。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiduo: a free, open-source file companion for Mac. Find files by sight, search text inside images, and clean up duplicates and big files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇 Shiduo：免费开源的 Mac 文件管家，看图找文件、搜图里的字、清理重复和大文件。"
          }
        }
      }
    },
    "拾掇依赖 Spotlight 索引。请确认“系统设置 ▸ Spotlight”中没有关闭文件索引。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiduo relies on the Spotlight index. Make sure file indexing isn’t turned off in System Settings ▸ Spotlight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇依赖 Spotlight 索引。请确认“系统设置 ▸ Spotlight”中没有关闭文件索引。"
          }
        }
      }
    },
    "拾掇反馈": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiduo feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇反馈"
          }
        }
      }
    },
    "拾掇反馈：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiduo feedback: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇反馈：%@"
          }
        }
      }
    },
    "拾掇只在两处联网：检查更新（只访问 GitHub 上本项目的发布页）和激活授权（只把授权码发给授权服务器校验）。你的文件从不上传。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiduo goes online for only two things: checking for updates (it only visits this project’s releases on GitHub) and activating a license (it only sends the license key to the license server). Your files are never uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇只在两处联网：检查更新（只访问 GitHub 上本项目的发布页）和激活授权（只把授权码发给授权服务器校验）。你的文件从不上传。"
          }
        }
      }
    },
    "拾掇开着时，每 10 分钟按规则整理一次": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Shiduo is open, rules run every 10 minutes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾掇开着时，每 10 分钟按规则整理一次"
          }
        }
      }
    },
