    "把所选移到废纸篓": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Selected to Trash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把所选移到废纸篓"
          }
        }
