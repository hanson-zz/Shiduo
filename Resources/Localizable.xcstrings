      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't undo this action, and the items won't go to the Trash. Files that are only in iCloud are skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不能撤销，也不会进废纸篓。只在 iCloud 云端的文件会被跳过。"
