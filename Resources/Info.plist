<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>LSHasLocalizedDisplayName</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Shiduo</string>
	<key>CFBundleName</key>
	<string>Shiduo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License · github.com/hanson-zz/Shiduo</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Shiduo reads files on your Desktop to show thumbnails, recognize text in screenshots, and find duplicates. Everything happens on this Mac.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Shiduo reads files in Documents to show thumbnails and find duplicates. Everything happens on this Mac.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Shiduo reads files in Downloads to group them by where they came from and find installers you can clean up. Everything happens on this Mac.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Shiduo reads files on external drives to show thumbnails.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Shiduo reads files on network drives to show thumbnails.</string>
</dict>
</plist>
